{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xTiger",
  "mainBinaryName": "xTiger",
  "version": "1.5.5-alpha",
  "identifier": "dev.xtiger.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "xTiger",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0A1530"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ck3-tiger",
      "binaries/xtiger-mcp"
    ],
    "publisher": "Qubis",
    "homepage": "https://github.com/9mirx0r/xTiger"
  }
}
