  "narrative": {
    "northStar": "The Night Workbench",
    "overview": "xTiger is the bench you work at late, next to the game and the editor: a deep navy surface lit by a single blue accent, with every tool within reach and nothing shouting. It is calm at rest and lively under the hand: controls press down, spring back with a small overshoot, and the results draw themselves in. A pixel font for the wordmark and eyebrow labels, and Qubis the blob as the maker's mark, keep the tool friendly without making it a toy.\n\nThe system is built for long sessions on dense information (reports, files, counts), so density and legibility come first and expression lives in details: the ASCII water behind the Home screen, severity colors as signal lights, the small brand-logo animations on assistant tiles. The light theme (\"Chart Paper\") is a first-class twin, not an inversion.",
    "keyCharacteristics": [
      "Deep-navy tonal layering instead of heavy shadows; one blue accent.",
      "Soft-edged, springy controls (8–12px radius, press-down scale, spring easing).",
      "Severity is the only multi-color vocabulary and always pairs color with a shape or label.",
      "Motion explains change (growing bars, popping badges, a bar that fills to Done) and is switched off by `prefers-reduced-motion`."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Signal Blue is the only accent; any other hue on screen means severity or a third-party brand logo.",
        "section": "colors"
      },
      {
        "name": "The Two Themes Rule",
        "body": "Every color is a token on `:root` with a `[data-theme=\"light\"]` twin. No raw hex in components except third-party brand marks.",
        "section": "colors"
      },
      {
        "name": "The Pixel Is a Wink Rule",
        "body": "Pixelify Sans appears only on the wordmark and eyebrows, never in body text or controls.",
        "section": "typography"
      },
      {
        "name": "The Flat-Until-Touched Rule",
        "body": "Surfaces are flat at rest; shadow or glow appears only in response to hover, focus or an overlay.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use tokens for every color and provide the light-theme twin.",
      "Do use `--ease-out` (cubic-bezier(0.22, 1, 0.36, 1)) for entrances and `--ease-spring` (cubic-bezier(0.34, 1.56, 0.64, 1)) for press and pop.",
      "Do keep animation CSS-only and let the global reduced-motion rule neutralize it.",
      "Do pair severity color with a label or a dot shape.",
      "Do keep all copy in plain English, short and literal."
    ],
    "donts": [
      "Don't add a second accent hue; severity and third-party logos are the only other colors.",
      "Don't use heavy resting shadows, gradient text, or glassmorphism beyond the modal backdrop blur.",
      "Don't load fonts, images or scripts from the network; CSP allows self only (`img-src 'self' data:`) and no inline scripts.",
      "Don't use Pixelify Sans for body text or controls.",
      "Don't let motion block work: the validation finish waits about 0.65s at most."
    ]
  }
